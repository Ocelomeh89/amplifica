# Canonical site origin — used for metadataBase, sitemap.xml, robots.txt, and
# JSON-LD. Set to https://amplificawealth.com in production once the domain
# points at this app (until then, the production Vercel URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Server-only (never NEXT_PUBLIC). Service role bypasses RLS; used for the
# public /calculator lead capture.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
BEEHIIV_API_KEY=<beehiiv-api-key>
BEEHIIV_PUBLICATION_ID=<beehiiv-publication-id>
